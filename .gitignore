packages/web/static/img/
# секреты (cookie сессии Untappd + ключи S3-хранилища) — gitignored ваулт проекта
data/.secrets/
.obsidian/workspace*
# sqlite WAL/shm (временные, сворачиваются чекпоинтом)
*.sqlite-wal
*.sqlite-shm

# главная БД каталога (~20МБ, данные-of-record): вне git, бэкап через снапшоты (TASK-66).
# rewort-*.sqlite (мелкие, трекаются) НЕ затрагиваем.
data/catalog.sqlite

# локальные снапшоты БД (scripts/backup-db.ts)
backups/

# эфемерный контекст диалога бота (TASK-46): «последний показанный сорт по чату», TTL — не источник правды
data/personal/.bot-context.json

# очередь петли обратной связи (TASK-55): pending-вопросы «как тебе вчерашнее?» — не источник правды
data/personal/.pending-tastings.json

# граф знаний graphify — локальный артефакт, детерминированно пересобирается `graphify .` (AST, без ключа)
graphify-out/

# scraped catalog data is not published
/data/*
