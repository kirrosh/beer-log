{
  "name": "beer-log",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "parse:tg": "bun run packages/parsers/src/run.ts",
    "catalog:export": "bun run scripts/export-catalog.ts",
    "digest:gen": "bun run scripts/gen-digest.ts",
    "demand:candidates": "bun run scripts/unmatched-brands.ts",
    "web": "bun --filter @beer-log/web dev",
    "web:build": "bun run catalog:export && bun run digest:gen && bun --filter @beer-log/web build",
    "venue:api": "bun run scripts/venue-server.ts",
    "venue:dev": "bun run scripts/venue-server.ts & bun --filter @beer-log/web dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
