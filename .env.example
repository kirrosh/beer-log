# Telegram-бот мини-аппа (TASK-34 #2). Скопируй в .env (gitignored) и заполни.

# Токен бота от @BotFather (https://t.me/BotFather → /newbot)
BOT_TOKEN=

# Публичный HTTPS-URL витрины для мини-аппа. Можно НЕ задавать — бот автодетектит
# запущенный ngrok (`bun run tunnel`). Задай явно, если хостишь витрину на своём домене.
# WEBAPP_URL=https://example.ngrok-free.app

# ПОСТОЯННЫЙ ngrok-домен (бесплатно, 1 на аккаунт): https://dashboard.ngrok.com/domains
# Заведи раз — и URL мини-аппа НЕ меняется между перезапусками `bun run mini`,
# старые кнопки и menu-кнопка в Telegram остаются рабочими. Без него ngrok даёт
# новый адрес при каждом старте (старые ссылки протухают).
# NGROK_DOMAIN=your-name.ngrok-free.app

# Адрес локального API точек (по умолчанию http://localhost:5174 — обычно менять не нужно)
# VENUE_API=http://localhost:5174
